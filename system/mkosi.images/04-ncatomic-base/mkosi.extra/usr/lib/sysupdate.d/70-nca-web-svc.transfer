[Transfer]
ProtectedVersion=%%OVERLAY_VERSION%%
Verify=false

[Source]
Type=tar
Path=/var/lib/updates/
MatchPattern=nca-web-svc_%%SYSTEM_VERSION%%_@v.tar.zstd

[Target]
Type=regular-file
Path=/var/lib/portables/
MatchPattern=nca-web-svc_%%SYSTEM_VERSION%%_@v.raw
CurrentSymlink=/var/lib/portables.active/nca-web-svc
