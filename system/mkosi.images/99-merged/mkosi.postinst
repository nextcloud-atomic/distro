# do
#   tar -caf "${img%.raw}.tar.gz" -C "${BUILDROOT}/usr/share/embedded/svc-extensions/" "$img"
#   rm "$img"
# done

# echo "done."

get_image_version() {
 local img image_version
 img="${1?Missing argument: image path}"

 if [[ "$img" =~ ".tar.gz"$ ]]
   then
   image_version="$(tar -tf "$img" | head -n 1)"
 else
   image_version="$img"
 fi
 image_version="${image_version##*_}"
 image_version="${image_version%.tar.*}"
 echo -n "$image_version"
}

if compgen -G "${SRCDIR}/portables"/*
then
  mkdir -p "${BUILDROOT}/usr/share/ncatomic/seed/portables"
  for img in "${SRCDIR}/portables"/*
  do
    [[ -L "$img" ]] || continue;
    img="$(readlink -f "$img")"
    img="$(basename "$img")"
    if [[ "$img" =~ ".tar.".*$ ]]
    then
      cp "$img" "${BUILDROOT}/usr/share/ncatomic/seed/portables/"
    else
      tar -caf "${BUILDROOT}/usr/share/ncatomic/seed/portables/${img%.raw}.tar.zst" --use-compress-program=zstd -C "${SRCDIR}/portables" "$img"
    fi
  done
fi

if compgen -G "${SRCDIR}/sysexts"/*
then
  mkdir -p "${BUILDROOT}/usr/share/ncatomic/seed/extensions"
  for img in "${SRCDIR}/sysexts"/*
  do
    [[ -L "$img" ]] || continue;
    img="$(readlink -f "$img")"
    img="$(basename "$img")"
    if [[ "$img" =~ ".tar.".*$ ]]
    then
      cp "$img" "${BUILDROOT}/usr/share/ncatomic/seed/extensions/"
    else
      tar -caf "${BUILDROOT}/usr/share/ncatomic/seed/extensions/${img}.tar.zst" --use-compress-program=zstd -C "${SRCDIR}/sysexts" "$img"
    fi
  done
fi

#if compgen -G "${BUILDROOT}/usr/share/embedded/portables/*.raw"
