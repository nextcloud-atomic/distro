#    mv "$img" "${img%_${IMAGE_VERSION}.*}_${IMAGE_VERSION}_${img_version}.${img##*.}"
#    set +x
#  done
#fi

#echo "done."


if compgen -G "${BUILDROOT}/usr/lib/sysupdate.d/*.transfer"
then
  echo "Updating variables in sysupdate transfer definitions ..."

  for transfer in "${BUILDROOT}/usr/lib/sysupdate.d/"*.transfer
  do
    image_pattern="$(grep '^MatchPattern=.*_@v.tar.' "$transfer" | head -n 1)"
    image_pattern="${image_pattern#MatchPattern=}"
    image_pattern="${image_pattern//%%SYSTEM_VERSION%%/}"
    image_pattern="${image_pattern//%%OVERLAY_VERSION%%/}"
    image_pattern="${image_pattern/__/_}"
    image_pattern="${image_pattern%_*.tar.*}"
    for img in "${BUILDROOT}/usr/share/ncatomic/seed/portables/${image_pattern}"* "${BUILDROOT}/usr/share/ncatomic/seed/extensions/${image_pattern}"*
    do
      [[ -f "$img" ]] || continue
      image_version="$(get_image_version "$img")"
      break
    done

    if [[ -z "${image_version:-}" ]]
    then
      echo "WARNING: No image found for pattern: ${image_pattern}"
      sleep 10
      continue
    fi

    sed -i \
      -e "s/%%OVERLAY_VERSION%%/${image_version?}/g" \
      -e "s/%%SYSTEM_VERSION%%/${IMAGE_VERSION?}/g" \
      "$transfer"
  done
fi

